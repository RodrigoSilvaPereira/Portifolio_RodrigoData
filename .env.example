# Configurações públicas do EmailJS, compatíveis com o projeto anterior.
# Copie para .env e preencha com os valores já usados na sua conta/projeto Vercel.
# A chave pública do EmailJS não é uma chave secreta de backend.
VITE_APP_EMAILJS_SERVICE_ID=
VITE_APP_EMAILJS_TEMPLATE_ID=
VITE_APP_EMAILJS_PUBLIC_KEY=
